{
  "name": "express-prisma-template",
  "version": "1.0.0",
  "description": "Plantilla multi-solución con Express, Prisma y PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run prisma:generate && npm --prefix frontend install && npm --prefix frontend run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "frontend:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3",
    "dotenv": "^18.0.1"
  }
}

{
  "name": "schemakit",
  "version": "1.0.0",
  "description": "Starter full-stack para lanzar varias soluciones sobre una misma base PostgreSQL, cada una aislada en su propio schema.",
  "main": "src/server.js",
  "type": "module",
  "license": "MIT",
  "author": "alejo bonavia",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run prisma:generate && npm --prefix frontend install && npm --prefix frontend run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "frontend:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^4.19.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3",
    "dotenv": "^18.0.1"
  }
}

NODE_ENV=development

# PostgreSQL local (Docker Compose)
DATABASE_URL="postgresql://app:app_password@localhost:5432/app_db?schema=solution_template"


# --- Base de datos (PostgreSQL) ---
# Estos valores se aplican solo cuando el volumen de la base es nuevo.
# Si el volumen ya existe, cambiarlos no modifica la base: hay que resetearla (docker compose down -v).
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
# Schema aislado de esta solución (cambialo en cada solución nueva)
POSTGRES_SCHEMA=solution_template

# --- Backend ---
PORT=3000
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173

# DATABASE_URL no se define acá: la arma docker-compose.yml para el container
# (host "db", puerto 5432). Solo si querés usar Prisma desde tu máquina
# (por ejemplo Prisma Studio), la URL sería:
# DATABASE_URL=postgresql://app:app_password@localhost:5433/app_db?schema=solution_template
